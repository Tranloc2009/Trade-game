# Server configuration
PORT=3000
NODE_ENV=development

# Optional backend-only secret (minimum 8 chars) to enable Admin/QA endpoints (/api/dev/*, /api/v4/dev/*, /api/diagnostics).
# Leave empty to keep all Admin/QA tools disabled while Career and Online gameplay run normally.
# NEVER prefix with VITE_ or expose this variable in frontend code.
ADMIN_DEV_SECRET=
