# Trading Empire — Prototype Mode Environment Configuration
# All variables below are OPTIONAL. The server runs with zero external secrets
# and automatically falls back to safe simulated/guest defaults if unset.
#
# Uncomment only if you explicitly want to override prototype defaults:
# PORT=3000
# NODE_ENV=development
# TRADING_EMPIRE_WORLD_ID=WORLD-01
# TRADING_EMPIRE_CALENDAR=SIMULATED
# TRADING_EMPIRE_DEV_TOOLS=true
#
# External Providers (all optional — disabled / guest simulated fallbacks by default):
# EXTERNAL_CRYPTO_PROVIDER=disabled
# EXTERNAL_STOCK_PROVIDER=disabled
# EXTERNAL_NEWS_PROVIDER=disabled
# EXTERNAL_AI_ANALYSIS_PROVIDER=disabled
# EXTERNAL_AUTH_PROVIDER=guest
